# Кэш и мусор не храним в репозитории
.sc_cache/
__pycache__/
*.log

# Личный плейлист, настройки оформления и профили — это ваши данные, а не код
playlist.json
theme_config.json

# Служебное
*.pyc

# Временные файлы проверок (всё, что начинается с подчёркивания)
_*.txt
_*.py

# Собранные архивы для выпуска (собираются скриптами сборки релиза)
Svinoklaud.zip
Свиноклауд-win64.zip

# Промежуточные папки PyInstaller (сами exe и zip для релиза собираются в dist/)
build/
dist/

# Бинарник yt-dlp кладётся рядом вручную (скачивается с github.com/yt-dlp/yt-dlp/releases)
yt-dlp.exe
